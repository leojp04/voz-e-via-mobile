# Copie este arquivo para ".env" e ajuste os valores. O ".env" nunca vai para o Git.
#
# ATENCAO: toda variavel EXPO_PUBLIC_* fica DENTRO do app instalado e qualquer pessoa
# consegue le-la. Nunca coloque senha, token ou chave secreta aqui.

# "true" usa a API falsa em memoria (desenvolvimento sem backend). Na entrega: "false".
EXPO_PUBLIC_USE_FAKE_API=true

# API Java: login, cadastro, assistente por voz, contatos e alertas.
EXPO_PUBLIC_JAVA_API_URL=http://localhost:8080

# API .NET: reportes de zeladoria.
EXPO_PUBLIC_DOTNET_API_URL=http://localhost:5080

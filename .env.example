# Copie este arquivo para ".env" e ajuste os valores. O ".env" nunca vai para o Git.
#
# ATENCAO: toda variavel EXPO_PUBLIC_* fica DENTRO do app instalado e qualquer pessoa
# consegue le-la. Nunca coloque senha, token ou chave secreta aqui.

# "true" usa a API falsa em memoria (desenvolvimento sem backend). Na entrega: "false".
EXPO_PUBLIC_USE_FAKE_API=false

# API Java: login, cadastro, assistente por voz, contatos e alertas. Publicada na Azure; para
# usar a API rodando no computador, troque por http://localhost:8080 (no emulador Android, use
# http://10.0.2.2:8080, porque "localhost" la e o proprio emulador).
EXPO_PUBLIC_JAVA_API_URL=https://app-vozviva-rm562312.azurewebsites.net

# API .NET: reportes de zeladoria. Publicada na Azure; local: http://localhost:5080.
EXPO_PUBLIC_DOTNET_API_URL=https://app-zeladoria-rm562312.azurewebsites.net
